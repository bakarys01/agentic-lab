{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    reverse_proxy backend:8000 {
        header_up -Forwarded

        transport http {
            dial_timeout 5s
            response_header_timeout 170s
        }
    }

    handle_errors {
        header Content-Type application/json
        header Cache-Control no-store
        respond `{"detail":"Le service est temporairement indisponible ou le délai de réponse est dépassé. Réessayez la même question pour vérifier son résultat."}` {err.status_code}
    }
}