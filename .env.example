# Core OpenAI / model access
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_hugging_face_token_here

# A2A specialist service hosts
A2A_BIND_HOST=127.0.0.1
POLICY_AGENT_PUBLIC_URL=http://127.0.0.1:9999
RESEARCH_AGENT_PUBLIC_URL=http://127.0.0.1:9998
HEALTHCARE_PROVIDER_AGENT_PUBLIC_URL=http://127.0.0.1:9997

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Local account and conversation storage (relative to project root)
DATABASE_PATH=data/concierge.sqlite3
# Enable only when the app is served over HTTPS
SESSION_COOKIE_SECURE=false

APP_DOMAIN=medinova.ton-domaine.fr
ACME_EMAIL=ton-adresse@example.com
